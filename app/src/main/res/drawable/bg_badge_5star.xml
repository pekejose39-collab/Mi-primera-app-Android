<?xml version="1.0" encoding="utf-8"?>
<!-- Insignia de rareza: layer-list = dos capas superpuestas (sombra dorada oscura + píldora dorada) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/divider_height">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_gold_dark" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
    <item android:bottom="@dimen/divider_height">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_gold" />
            <corners android:radius="@dimen/button_radius" />
        </shape>
    </item>
</layer-list>
