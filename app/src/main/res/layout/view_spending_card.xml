<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de gasto mensual con barra de progreso. Reutilizada en móvil y tablet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card.GachaTrack"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_spending_amount"
        style="@style/Text.GachaTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pb_spending"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_height"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_s"
        android:max="@integer/progress_max"
        android:progressDrawable="@drawable/progress_spending" />

    <TextView
        android:id="@+id/tv_spending_hint"
        style="@style/Text.GachaTrack.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
