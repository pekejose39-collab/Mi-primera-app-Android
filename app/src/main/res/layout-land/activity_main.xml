<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA 1 (móvil en horizontal, ampliación opcional layout-land): mismo contenido, pero en DOS columnas.
    Izquierda: gasto del mes + botón. Derecha: lista de juegos.
    Android elige este fichero al girar el móvil; los ids son los mismos,
    así que MainActivity.java funciona igual sin cambios.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_header_main" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_l">

            <!-- Columna izquierda -->
            <LinearLayout
                android:layout_width="@dimen/dim_zero"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_l"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.GachaTrack.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_spending" />

                <include layout="@layout/view_spending_card" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_new_session"
                    style="@style/Button.GachaTrack"
                    android:text="@string/btn_new_session" />
            </LinearLayout>

            <!-- Columna derecha -->
            <LinearLayout
                android:layout_width="@dimen/dim_zero"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.GachaTrack.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_games" />

                <include layout="@layout/view_game_list" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
